# TypeSafe AI — every judgment in Unslop comes from Jev.
# Create a key at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Browserbase — web mode only (loads the URL, screenshots it, returns the HTML).
# Without these, web mode falls back to a plain fetch and has no screenshot.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional overrides (SDK defaults shown)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# PORT=8787
